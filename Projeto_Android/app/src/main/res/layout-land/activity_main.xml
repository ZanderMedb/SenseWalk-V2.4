<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- V2.1: layout dedicado ao uso horizontal. O vídeo ocupa toda a tela. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/espImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_camera_vignette" />

    <com.travessia.segura.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Barra superior compacta para não esconder a cena -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glass_panel"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_status_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvScreenTitle"
                android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Análise de Tráfego"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAlertStatus"
                android:fontFamily="sans-serif"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Aguardando câmera"
                    android:textColor="#BDE7F4FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFps"
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="0 FPS"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Painel inferior horizontal: pouco alto, preservando o campo de visão. -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_bottom_panel"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEstado"
                android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="INATIVO"
                    android:textColor="#FFFFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSituacao"
                android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="---"
                    android:textColor="#88FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvDetectionCount"
                android:fontFamily="sans-serif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="Veículos: 0"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvInfo"
                android:fontFamily="sans-serif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Carregando modelo..."
                    android:textColor="#DDE7F4FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToggle"
                android:fontFamily="sans-serif-medium"
                android:layout_width="110dp"
                android:layout_height="48dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_button_primary"
                android:enabled="false"
                android:text="Iniciar"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSource"
                android:fontFamily="sans-serif-medium"
                android:layout_width="105dp"
                android:layout_height="48dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Celular"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnVoice"
                android:fontFamily="sans-serif-medium"
                android:layout_width="82dp"
                android:layout_height="48dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Voz"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConfig"
                android:fontFamily="sans-serif-medium"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Config."
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
